{
  "name": "@dugble/sdk",
  "version": "0.1.1",
  "description": "Official Node.js and TypeScript SDK for the Dugble API.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "prepublishOnly": "npm run check",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "check": "biome check . && npm run typecheck && npm test && npm run build",
    "format:check": "biome format .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dugble/dugble-node.git"
  },
  "bugs": {
    "url": "https://github.com/dugble/dugble-node/issues"
  },
  "homepage": "https://github.com/dugble/dugble-node#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
